# --- Force PHP 8.2 (preserve working config) ---
AddType application/x-httpd-php82 .php

<IfModule mod_env.c>
    SetEnv PHPRC /opt/cpanel/ea-php82/root/etc
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php index.html index.htm
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Security: block dotfiles (except .well-known), sensitive files & internal dirs ---
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(env|sql|log|bak|sh|ini|lock|yml|yaml)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|README\.md)$ - [F,L]

    # --- Static landing pages (clean URLs) ---
    RewriteRule ^$ index.php [L]
    RewriteRule ^mitra/?$ mitra.php [L]
    RewriteRule ^detail/?$ detail.php [L]

    # --- Serve real existing files/dirs directly (images, build assets, .well-known) ---
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Everything else -> Laravel (login, dashboard, livewire, etc.) ---
    RewriteRule ^ /public/index.php [QSA,L]
</IfModule>
